# ═══════════════════════════════════════════════════════════════
# AI YOUTUBE AUTOMATION OS — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Server Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=change-this-to-a-random-64-character-secret-key

# ═══════════════════════════════════════════════════════════════
# AI Provider API Keys (Optional — system works without them using
# intelligent mock fallback for testing and development)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=

# ═══════════════════════════════════════════════════════════════
# YouTube Data API v3 (OAuth2)
# Get these from Google Cloud Console > APIs & Services > Credentials
# ═══════════════════════════════════════════════════════════════
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/oauth2callback

# ═══════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════
STORAGE_PATH=./storage
DATABASE_PATH=./storage/database.sqlite
